<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="特别短信提醒"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvAppSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="仅做短信增强提醒 · 零后台常驻"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="2dp" />

    <!-- Status Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_bg"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppSubTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="短信监听服务"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvStatusDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="开启后将动态注册短信广播并配置兜底任务"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvStatusLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/switchListener"
                android:layout_marginEnd="16dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchListener"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Permission Warning Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPermissions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_bg"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPermissionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="权限状态校验"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/tvPermissionSms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 短信读取与接收权限：已授权"
                android:textSize="12sp"
                android:textColor="@color/green"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvPermissionNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 发送通知权限：已授权"
                android:textSize="12sp"
                android:textColor="@color/green"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnRequestPermissions"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测并跳转权限设置"
                android:textColor="@color/primary"
                android:layout_gravity="end"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Contacts Header -->
    <TextView
        android:id="@+id/tvContactsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="特别关注名单"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardPermissions"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBaseline_toBaselineOf="@id/tvContactsTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnImportContact"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="通讯录导入"
            android:textColor="@color/primary"
            android:padding="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/btnAddContact"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手动添加"
            android:textColor="@color/primary"
            android:layout_marginStart="16dp"
            android:padding="0dp"
            android:minWidth="0dp" />

    </LinearLayout>

    <!-- Contacts List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContacts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvContactsTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_special_contact" />

    <TextView
        android:id="@+id/tvNoContacts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂无特别关注联系人，请点击右上角添加"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        app:layout_constraintTop_toTopOf="@id/rvContacts"
        app:layout_constraintBottom_toBottomOf="@id/rvContacts"
        app:layout_constraintStart_toStartOf="@id/rvContacts"
        app:layout_constraintEnd_toEndOf="@id/rvContacts"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
