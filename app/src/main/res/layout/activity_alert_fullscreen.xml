<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- 铃铛 -->
        <FrameLayout
            android:id="@+id/flBellContainer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivAlertBell"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alert_bell"
                app:tint="?attr/colorError" />
        </FrameLayout>

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="短信钉 — 特别关注提醒"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorError"
            android:letterSpacing="0.05"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/flBellContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 发件人 -->
        <TextView
            android:id="@+id/tvAlertSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvAlertTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 短信正文 -->
        <TextView
            android:id="@+id/tvAlertContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="6"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_alert_content"
            app:layout_constraintTop_toBottomOf="@id/tvAlertSender"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 停止按钮：硬约束到底部，永远不跑 -->
        <TextView
            android:id="@+id/btnDismiss"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="我已知晓，停止提醒"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:background="@drawable/bg_dismiss_btn"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvAlertContent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
