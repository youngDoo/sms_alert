<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- 联系人头像/首字母 -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="张"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/bg_avatar_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 姓名 -->
        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="0dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            android:layout_height="wrap_content"
            android:text="张三"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/tvAvatar"
            app:layout_constraintStart_toEndOf="@id/tvAvatar" />

        <!-- 号码 -->
        <TextView
            android:id="@+id/tvContactPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="13800138000"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:ellipsize="middle"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvContactName"
            app:layout_constraintStart_toEndOf="@id/tvAvatar"
            app:layout_constraintEnd_toStartOf="@id/btnDelete" />

        <!-- 铃声标签 -->
        <TextView
            android:id="@+id/tvRingtoneDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="闹钟音 · 30秒"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:background="@drawable/bg_tag_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvAvatar"
            app:layout_constraintStart_toStartOf="@id/tvAvatar" />

        <!-- 删除按钮 -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:contentDescription="删除"
            app:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
